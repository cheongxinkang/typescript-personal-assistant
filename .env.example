# Copy to .env and fill in real values. This file is checked into git and
# must never contain a real secret.

# Discord bot token, from the Developer Portal's Bot tab.
# Requires the "Message Content" privileged intent enabled — see
# docs/running-locally.md.
DISCORD_BOT_TOKEN=

# The Discord channel ID the bot listens on. Messages in any other channel
# are ignored. Enable Developer Mode in Discord to copy a channel ID.
DISCORD_CHANNEL_ID=

# Anthropic API key, from console.anthropic.com.
ANTHROPIC_API_KEY=

# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/personal_assistant

# IANA timezone used to resolve date expressions like "tomorrow 7pm",
# e.g. Asia/Singapore, America/New_York, Europe/London.
OWNER_TIMEZONE=
